{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ginmp8/MockProxyGateway/blob/main/docs/rules.schema.json",
  "title": "MockProxyGateway rule document v1",
  "description": "Structural contract. Runtime validation additionally checks destination approval, unique IDs, priorities, route conflicts, operand types, resource budgets and fixtures.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "destinations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/destination"
      },
      "maxProperties": 256
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      },
      "maxProperties": 256
    }
  },
  "required": [
    "schemaVersion",
    "destinations",
    "services"
  ],
  "additionalProperties": false,
  "$defs": {
    "destination": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "removeQuery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "baseUrl"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "body": {},
        "text": {
          "type": "string"
        },
        "bodyFile": {
          "type": "string"
        }
      },
      "required": [
        "statusCode"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "body"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "bodyFile"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "text"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "body"
                ]
              },
              {
                "required": [
                  "bodyFile"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "bodyFile"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "body"
                ]
              },
              {
                "required": [
                  "text"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "body"
                ]
              },
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "bodyFile"
                ]
              }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "statusCode": {
                "enum": [
                  204,
                  205,
                  304
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "body"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "bodyFile"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "mock"
            },
            "response": {
              "$ref": "#/$defs/response"
            }
          },
          "required": [
            "mode",
            "response"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "proxy"
            },
            "destination": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "pathRewrite": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": [
            "mode",
            "destination"
          ],
          "additionalProperties": false
        }
      ]
    },
    "leaf": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "header",
            "query",
            "body",
            "route",
            "cookie",
            "contentType",
            "method",
            "path"
          ]
        },
        "key": {
          "type": "string"
        },
        "operator": {
          "enum": [
            "equals",
            "notEquals",
            "exists",
            "notExists",
            "isNull",
            "contains",
            "startsWith",
            "endsWith",
            "in",
            "notIn",
            "regex",
            "greaterThan",
            "greaterThanOrEqual",
            "lessThan",
            "lessThanOrEqual",
            "between",
            "jsonEquals"
          ]
        },
        "value": {},
        "quantifier": {
          "enum": [
            "any",
            "all",
            "none"
          ]
        },
        "ignoreCase": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "operator"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "method",
                  "path",
                  "contentType"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "key"
              ]
            }
          },
          "else": {
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "exists",
                  "notExists",
                  "isNull"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          },
          "else": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "notIn"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "between"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "conditions": {
          "$ref": "#/$defs/condition"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "id",
        "priority",
        "conditions",
        "action"
      ],
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "default": {
          "$ref": "#/$defs/action"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      },
      "required": [
        "method",
        "path"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/action"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
